# Trader 运行配置（Windows 示例）
# 首次使用请填写真实的 LLM_API_KEY；不要提交包含密钥的 .env 文件。
# LLM_BASE_URL 填 OpenAI-compatible API 根地址，不是 /chat/completions。
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# 分析报告和最终决策输出中文（不改变 CLI 菜单文字）。
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese

# 默认结果根目录；在其他机器上按实际磁盘路径修改。
TRADINGAGENTS_RESULTS_DIR=E:\Trader_Reports
